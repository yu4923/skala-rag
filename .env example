# 서비스 인증 키
OPENAI_API_KEY=
TAVILY_API_KEY=

# Agent 모델
FOUNDER_MODEL=gpt-4o-mini
MARKET_MODEL=gpt-4o-mini
TECH_MODEL=gpt-4o
INVESTMENT_MODEL=gpt-4o

# LangSmith 추적
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=RAG-Project

# 평가 점수와 판단 기준
RECOMMEND_SCORE=50.0
RAW_SCORE_MAX=5.0
MIN_CRITERION_SCORE=1.0
FOUNDER_WEIGHT=25.0
MARKET_GROWTH_WEIGHT=25.0
CUSTOMER_DEMAND_WEIGHT=25.0
TECH_SPECIFICITY_WEIGHT=15.0
TECH_DIFFERENTIATION_WEIGHT=10.0

# 재평가 및 근거 조건
MAX_RETRIES=1
MIN_EVIDENCE_COUNT=1
STOP_ON_FIRST_RECOMMENDATION=true

# 그래프 실행 설정
GRAPH_RECURSION_LIMIT=500
SCORE_TOLERANCE=1e-6

# 기본 평가 입력
COMPANIES=엔라이튼,해줌,식스티헤르츠,시너지,인코어드테크놀로지스,브이피피랩,브이젠,에너지엑스,크로커스에너지,러셀
DEFAULT_REQUEST=후보 기업을 순서대로 평가하고 추천할 기업이 나오면 즉시 해당 기업의 보고서를 작성해줘
